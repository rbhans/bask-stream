{
  "name": "@basidekick/baskstream",
  "version": "0.1.0",
  "description": "TypeScript client for the baskStream Niagara 4 WebSocket API, with the engines built on it: why, log, values at a moment, checkouts, the site model, checks, export, diff and apply.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbhans/bask-stream.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/rbhans/bask-stream/tree/main/sdk#readme",
  "bugs": "https://github.com/rbhans/bask-stream/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "node scripts/gen-operations.mjs",
    "build": "npm run gen && node node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "ws": "^8.18.3",
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
