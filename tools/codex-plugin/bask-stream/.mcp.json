{
  "mcpServers": {
    "bask-stream": {
      "command": "node",
      "args": [
        "./bin/launch-mcp.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "BASKSTREAM_STATION_URL",
        "BASKSTREAM_USER",
        "BASKSTREAM_PASSWORD",
        "NIAGARA_URL",
        "NIAGARA_USER",
        "NIAGARA_PASSWORD",
        "STREAM_PASSWORD",
        "BASKSTREAM_VERIFY_TLS",
        "BASKSTREAM_CA_FILE",
        "BASKSTREAM_TIMEOUT_MS",
        "BASKSTREAM_ALLOW_WRITES",
        "BASKSTREAM_ALLOW_TAG_WRITES",
        "BASKSTREAM_ALLOW_ALARM_ACTIONS",
        "BASKSTREAM_ALLOW_RAW",
        "BASKSTREAM_CONFIG",
        "BASK_STREAM_WORKSPACE",
        "CODEX_WORKSPACE_ROOT",
        "WORKSPACE_ROOT",
        "BASK_STREAM_MCP_CONFIG",
        "BASK_STREAM_URL",
        "BASK_STREAM_USERNAME",
        "BASK_STREAM_PASSWORD",
        "BASK_STREAM_REJECT_UNAUTHORIZED",
        "BASK_STREAM_REQUEST_TIMEOUT_MS",
        "BASK_STREAM_ENABLE_MUTATIONS",
        "BASK_STREAM_ALLOWED_ORD_PREFIXES"
      ],
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 120
    }
  }
}
